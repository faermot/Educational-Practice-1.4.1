<Window x:Class="Tic_tac_toe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Крестики-нолики" Height="450" Width="350">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Крестики-нолики"
                   FontSize="30"
                   HorizontalAlignment="Left"
                   Grid.ColumnSpan="3"
                   VerticalAlignment="Top"
                   Grid.Row="0" Margin="58,10,0,0"/>

        <TextBlock x:Name="playerText"
               Text="Ход: X"
               FontSize="24"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,10"/>

        <Button Background="Transparent" 
                x:Name="cell1" Grid.Row="1" 
                Grid.Column="0" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell2" Grid.Row="1" 
                Grid.Column="1" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell3" Grid.Row="1" 
                Grid.Column="2" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell4" Grid.Row="2" 
                Grid.Column="0" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell5" Grid.Row="2" 
                Grid.Column="1" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell6" Grid.Row="2" 
                Grid.Column="2" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell7" Grid.Row="3" 
                Grid.Column="0" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell8" Grid.Row="3" 
                Grid.Column="1" Click="Cell_Click" FontSize="50"/>
        <Button Background="Transparent" 
                x:Name="cell9" Grid.Row="3" 
                Grid.Column="2" Click="Cell_Click" FontSize="50"/>

        <Button Content="Начать заново" 
                Grid.Row="4" Grid.ColumnSpan="3" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Click="RestartButton_Click" FontSize="20"/>
    </Grid>
</Window>
